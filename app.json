{
  "expo": {
    "name": "TimePulse Attendance",
    "slug": "timepulse-attendance",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.promise.timepulse"
    },
    "android": {
      "package": "com.promise.timepulse",
      "versionCode": 1,
      "adaptiveIcon": {
        "backgroundColor": "#0F172A",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png"
      },
      "permissions": [
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "INTERNET",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "TimePulse needs your location to verify attendance."
        }
      ],
      "expo-font"
    ],
    "extra": {
      "eas": {
        "projectId": "9a0de16e-b66c-4cbe-ade9-fb9d22a42300"
      }
    },
    "owner": "naem0"
  }
}
