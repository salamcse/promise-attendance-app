{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "local"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal"
    },
    "preview": {
      "android": {
        "buildType": "apk"
      },
      "distribution": "internal",
      "env": {
        "EXPO_PUBLIC_API_URL": "https://dev.promiseassets.com/api/v1",
        "EXPO_PUBLIC_OFFICE_LATITUDE": "23.777702",
        "EXPO_PUBLIC_OFFICE_LONGITUDE": "90.361081",
        "EXPO_PUBLIC_OFFICE_RADIUS_METERS": "150"
      }
    },
    "production": {
      "autoIncrement": true,
      "env": {
        "EXPO_PUBLIC_API_URL": "https://dev.promiseassets.com/api/v1",
        "EXPO_PUBLIC_OFFICE_LATITUDE": "23.777702",
        "EXPO_PUBLIC_OFFICE_LONGITUDE": "90.361081",
        "EXPO_PUBLIC_OFFICE_RADIUS_METERS": "150"
      }
    }
  },
  "submit": {
    "production": {}
  }
}
